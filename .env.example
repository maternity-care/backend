APP_NAME=Maternity Care API
NODE_ENV=development
PORT=84
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=https://your-frontend-domain.com,https://admin.your-domain.com

JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Maternity Care
MAIL_FROM_ADDRESS=no-reply@example.com

DB_HOST=maternity-mariadb
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=maternity_care

REDIS_HOST=maternity-redis
REDIS_PORT=6379
REDIS_PASSWORD=password

BCRYPT_SALT_ROUNDS=10

STORAGE_DRIVER=s3
S3_BUCKET=maternity-care
S3_REGION=ap-southeast-1
S3_ENDPOINT=url
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_PRESIGN_EXPIRES_IN=300
UPLOAD_OBJECT_ACL=public-read
UPLOAD_DOWNLOAD_EXPIRES_IN=3600
UPLOAD_USER_RATE_LIMIT=20
UPLOAD_MANAGEMENT_RATE_LIMIT=60
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=600
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Google AI Studio / Gemini
# Lấy key tại https://aistudio.google.com/app/apikey rồi để trong backend env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
